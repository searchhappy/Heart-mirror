## 心语镜像 - 环境变量示例
## 复制为 .env 后按需填写（不要提交 .env）

# 模型提供方: auto / xf / ollama
MODEL_PROVIDER=auto

# 是否启用 RAG。排查讯飞问题时建议先设为 false
ENABLE_RAG=false
HF_ENDPOINT=https://hf-mirror.com
OLLAMA_MODEL=qwen2.5:7b

# 讯飞 Spark（如使用 core/llm_xf.py）
XF_APP_ID=
XF_API_KEY=
XF_API_SECRET=
XF_URL=wss://spark-api.xf-yun.com/v4.0/chat
XF_DOMAIN=4.0Ultra

# JWT（core/auth.py）
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=7
